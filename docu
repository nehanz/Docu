#!/usr/bin/env python3
"""
docu - session logger with AI assistant
Saves logs to: <save_dir>/<session_name>/commands.txt
Also saves commands and their outputs to: <save_dir>/<session_name>/all.txt
"""

import argparse
import os
import re
import shlex
import subprocess
import textwrap
import sys
import tty
import termios
import requests
from pathlib import Path
from typing import Optional

# colors
class Color:
    RESET = "\033[0m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    BLUE = "\033[34m"
    CYAN = "\033[36m"
    BOLD = "\033[1m"

# active session tracking
ACTIVE_SESSION_FILE = Path.home() / ".docu_active_session"


def set_active_session(session_dir: Path):
    with ACTIVE_SESSION_FILE.open("w") as f:
        f.write(str(session_dir))

def clear_active_session():
    """Clear active session"""
    if ACTIVE_SESSION_FILE.exists():
        ACTIVE_SESSION_FILE.unlink()

def get_active_session() -> Optional[Path]:
    """Return currently active session path"""
    if ACTIVE_SESSION_FILE.exists():
        with ACTIVE_SESSION_FILE.open("r") as f:
            path = Path(f.read().strip())
        if path.exists():
            return path
    return None

# utilities
def get_last_number(log_path: Path) -> int:
    if not log_path.exists():
        return 0
    maxn = 0
    with log_path.open("r", encoding="utf-8", errors="ignore") as fh:
        for line in fh:
            m = re.match(r'^\s*(\d+)\s+', line)
            if m:
                n = int(m.group(1))
                if n > maxn:
                    maxn = n
    return maxn

def date_for_log() -> str:
    res = subprocess.run(
        ["date", "+%a %b %e %I:%M:%S %p %Z %Y"],
        capture_output=True, text=True
    )
    return res.stdout.strip()

def recent_session(save_path: Path) -> Optional[Path]:
    if not save_path.exists() or not save_path.is_dir():
        return None
    sessions = [d for d in save_path.iterdir() if d.is_dir()]
    if not sessions:
        return None
    sessions.sort(key=lambda d: d.stat().st_mtime, reverse=True)
    return sessions[0]

def add_comment(comment: str, session_name: Optional[str], save_dir: str) -> int:

    text = " ".join(comment)
    active = get_active_session()
    if not active:
        print("No active docu session found.")
        print("Start one using: docu start --name <session_name>")
        exit(1)

    save_path = Path(save_dir).expanduser().resolve()

    active = get_active_session()
    if active:
        session_dir = active
    elif session_name:
        session_dir = save_path / session_name
        if not session_dir.exists():
            print(f"Session '{session_name}' not found in {save_path}")
            return 1
    else:
        session_dir = recent_session(save_path)
        if session_dir is None:
            print(f"No previous sessions found in {save_path}")
            return 1

    log_file = session_dir / "commands.txt"
    all_file = session_dir / "all.txt"
    comment_line = f"# {text}\n"
    try:
        with log_file.open("a", encoding="utf-8") as lf:
            lf.write(comment_line)
        with all_file.open("a", encoding="utf-8") as af:
            af.write(comment_line)
    except Exception as e:
        print(f"Failed to write comment: {e}")
        return 1
    return 0

# Start Session
def start_session(session_name: str, save_dir: str):
    save_path = Path(save_dir).expanduser().resolve()
    session_dir = save_path / session_name
    session_dir.mkdir(parents=True, exist_ok=True)
    set_active_session(session_dir)

    log_file = session_dir / "commands.txt"
    all_file = session_dir / "all.txt"
    last_number = get_last_number(log_file)

    rcfile_path = session_dir / ".docu_rc"
    quoted_log = shlex.quote(str(log_file))
    quoted_all = shlex.quote(str(all_file))

    rc_contents = fr"""# docu rcfile (auto-generated)

if [ -f ~/.bashrc ]; then
    source ~/.bashrc
fi

export LOG_FILE={quoted_log}
export ALL_FILE={quoted_all}
export DOCU_COUNTER={last_number}
export DOCU_LAST_CMD=""
export DOCU_LAST_CMD2=""
export DOCU_SESSION_STARTED=0
export DOCU_MASK=0

docu() {{
    if [[ "$1" == "mask" ]]; then
        if [[ "$DOCU_MASK" -eq 0 ]]; then
            export DOCU_MASK=1
            echo -e "{Color.BOLD}{Color.RED}docu mask: Output logging is now OFF{Color.RESET}"
        else
            export DOCU_MASK=0
            echo -e "{Color.BOLD}{Color.GREEN}docu mask: Output logging is now ON{Color.RESET}"
        fi
        return 0
    fi
    command docu "$@"
}}

log() {{
    CMD=$(history 1 | sed "s/^ *[0-9]\+ *//")

    if [[ "$CMD" == docu* ]]; then
        return  
    fi

    if [[ "$CMD" != "exit" && "$CMD" != "" ]]; then
        # Only log if cmd is correct
        if [[ "$CMD" != "$DOCU_LAST_CMD" && "$CMD" != "$DOCU_LAST_CMD2" ]]; then
            # Check if command exists
            CMD_NAME=$(echo "$CMD" | awk '{{print $1}}')
            if ! command -v "$CMD_NAME" >/dev/null 2>&1; then
                return
            fi
            if [[ "$DOCU_SESSION_STARTED" -eq 0 ]]; then
                echo "--- Session started at $(date "+%a %b %e %I:%M:%S %p %Z %Y") ---" >> "$LOG_FILE"
                echo "--- Session started at $(date "+%a %b %e %I:%M:%S %p %Z %Y") ---" >> "$ALL_FILE"
                export DOCU_SESSION_STARTED=1
            fi
            DOCU_COUNTER=$((DOCU_COUNTER + 1))
            printf "%s  %s\n" "$DOCU_COUNTER" "$CMD" >> "$LOG_FILE"
            export DOCU_LAST_CMD2="$DOCU_LAST_CMD"
            export DOCU_LAST_CMD="$CMD"

            if [[ "$DOCU_MASK" -eq 0 ]]; then
                {{
                    echo "### [$DOCU_COUNTER] $CMD"
                    echo "--- Output ---"
                    eval "$CMD"
                    STATUS=$?
                    echo "--- Exit code: $STATUS ---"
                    echo ""
                }} >> "$ALL_FILE" 2>&1
            else
                {{
                    echo "### [$DOCU_COUNTER] $CMD"
                    echo "--- Output masked ---"
                    echo ""
                }} >> "$ALL_FILE"
            fi
        fi
    fi
}}

export PROMPT_COMMAND=log
trap 'if [[ "$DOCU_SESSION_STARTED" -eq 1 ]]; then echo "--- Session ended at $(date "+%a %b %e %I:%M:%S %p %Z %Y") ---" >> "$LOG_FILE"; echo "--- Session ended at $(date "+%a %b %e %I:%M:%S %p %Z %Y") ---" >> "$ALL_FILE"; fi; command docu internal_clear_session' EXIT
"""

    rcfile_path.write_text(rc_contents, encoding="utf-8")
    rcfile_path.chmod(0o600)

    print(f"{Color.GREEN}Session '{session_name}' started{Color.RESET}")
    print(f"{Color.GREEN}Logging to: {log_file}{Color.RESET}")
    print(f"{Color.GREEN}Logging commands and output to: {all_file}{Color.RESET}")
    print(f"{Color.RED}Type 'exit' to stop logging.{Color.RESET}")
    print(f"{Color.CYAN}Use 'docu mask' inside a session to mask the output.{Color.RESET}")

    bash_path = "/bin/bash"
    if not Path(bash_path).exists():
        bash_path = os.environ.get("SHELL", "/bin/sh")
        print(f"/bin/bash not found, falling back to {bash_path}.")

    # try:
    #     os.chdir(str(session_dir))
    # except FileNotFoundError:
    #     os.chdir(str(Path.home()))

    try:
        subprocess.call([bash_path, "--rcfile", str(rcfile_path)])
    finally:
        for file in [log_file, all_file]:
            if file.exists():
                lines = file.read_text(encoding="utf-8", errors="ignore").splitlines()
                start_idx = None
                for i in range(len(lines)-1, -1, -1):
                    if lines[i].startswith("--- Session started at"):
                        start_idx = i
                        break
                ended = any(ln.startswith("--- Session ended at") for ln in lines[start_idx+1:]) if start_idx is not None else False
                if start_idx is not None and not ended:
                    end_time = date_for_log()
                    with file.open("a", encoding="utf-8") as lf:
                        lf.write(f"--- Session ended at {end_time} ---\n")
        clear_active_session()  # 🔹 clear session when exited

    print(f"{Color.CYAN}Session saved to: {log_file}{Color.RESET}")
    print(f"{Color.CYAN}Session (with output) saved to: {all_file}{Color.RESET}")

def stop_session():
    print("Sessions stop automatically when you exit the shell.")

# AI Assistant
def load_env(filepath: Optional[str] = None) -> bool:
    candidates = []
    if filepath:
        candidates.append(Path(filepath))
    candidates.extend([
        Path.cwd() / ".env",
        Path(__file__).resolve().parent / ".env",
        Path.home() / ".env",
        Path.home() / "VSC" / "docu_tool" / ".env",
    ])

    # deduplicate while preserving order
    seen = set()
    paths = []
    for p in candidates:
        rp = p.resolve() if p.exists() else p
        if str(rp) not in seen:
            seen.add(str(rp))
            paths.append(rp)

    found = None
    for p in paths:
        if p.exists():
            found = p
            break

    if not found:
        tried = "\n".join(f" - {p}" for p in paths)
        print(f"\033[91mWarning:\033[0m No .env found. Tried:\n{tried}")
        return False

    try:
        with found.open("r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("export "):
                    line = line[len("export ") :].lstrip()
                if "=" in line:
                    key, value = line.split("=", 1)
                    key = key.strip()
                    value = value.strip()
                    if (value.startswith('"') and value.endswith('"')) or (
                        value.startswith("'") and value.endswith("'")
                    ):
                        value = value[1:-1]
                    os.environ[key] = value
        return True
    except Exception as e:
        print(f"\033[91mError loading .env:\033[0m {e}")
        return False

def ai_response(prompt: str) -> str:
    API_KEY = os.getenv("GEMINI_API_KEY")
    API_URL = os.getenv("GEMINI_API_URL")
    if not API_KEY or not API_URL:
        return "[Error] Missing GEMINI_API_KEY or GEMINI_API_URL in .env"
    headers = {"Content-Type": "application/json", "X-goog-api-key": API_KEY}
    data = {"contents": [{"parts": [{"text": prompt}]}]}
    try:
        response = requests.post(API_URL, headers=headers, json=data, timeout=60)
        response.raise_for_status()
        output = response.json()
        return output["candidates"][0]["content"]["parts"][0]["text"].strip()
    except Exception as e:
        return f"[Error contacting Gemini] {e}"

def multiline_input(prompt_msg):
    print(prompt_msg)
    print("(Shift+Enter for newline)\n")
    lines = []
    while True:
        try:
            line = input()
            if not line.strip() and lines:
                break
            lines.append(line)
        except EOFError:
            break
    return "\n".join(lines).strip()

