# CLI
def main():
    parser = argparse.ArgumentParser(prog="docu", description="Document your terminal sessions with AI Assist")
    parser.add_argument("--comment", "-c", nargs="+", help="Add a comment on log file")
    sub = parser.add_subparsers(dest="cmd", required=False)

    p_start = sub.add_parser("start", help="Start a logging session")
    p_start.add_argument("--name", "-n", required=True, help="Session name")
    p_start.add_argument("--save", "-s", default="~/Documents/docu", help="Directory to save sessions")

    sub.add_parser("stop", help="Stop session (informational)")
    sub.add_parser("askai", help="Ask AI Assistant")
    sub.add_parser("mask", help="Toggle output logging for sensitive commands")
    sub.add_parser("internal_clear_session", help=argparse.SUPPRESS) 

    args = parser.parse_args()

    # Unified command handling
    if args.cmd == "start":
        start_session(args.name, args.save)
    elif args.comment:
        session_name = getattr(args, "name", None)
        save_dir = getattr(args, "save", "~/Documents/docu")
        add_comment(args.comment, session_name, save_dir)
    elif args.cmd == "stop":
        stop_session()
    elif args.cmd == "askai":
        ask_ai()
    elif args.cmd == "mask":
        print("Use 'docu mask' inside a session to mask the output")
    elif args.cmd == "internal_clear_session":
        clear_active_session()
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
